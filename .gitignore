# Do not globally ignore *.obj, *.dll, *.lib, *.exe or *.pdb.
# Those may be legitimate source/vendor assets; generated output is excluded by directories above.

# Canonical local package archive
Artifacts/

# Local full-ref safety bundle; preserve on disk but never treat it as working-tree content.
/PINK-CAB_ALL_REFS.bundle
